APP_NAME="Anjem API"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.anjem.me

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — separate staging database on same server
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anjem_staging
DB_USERNAME=forge
DB_PASSWORD=           # <-- fill from Forge

# Caching and Sessions
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true

# Redis — prefixed to isolate from production on same server
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_PREFIX=anjem_staging_

# Email — use Mailtrap sandbox for staging (don't send real emails)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=           # <-- fill from Mailtrap
MAIL_PASSWORD=           # <-- fill from Mailtrap
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@anjem.me"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=staging-api.anjem.me

# Laravel Reverb WebSocket
REVERB_APP_ID=anjem-staging
REVERB_APP_KEY=           # <-- generate unique key
REVERB_APP_SECRET=        # <-- generate unique secret
REVERB_HOST=staging-ws.anjem.me
REVERB_PORT=443
REVERB_SCHEME=https

# Firebase — same project as production (shared auth)
FIREBASE_SERVER_KEY=      # <-- same as production
FIREBASE_PRIVATE_KEY_ID=  # <-- same as production
FIREBASE_PRIVATE_KEY=     # <-- same as production
FIREBASE_CLIENT_EMAIL=    # <-- same as production
FIREBASE_CLIENT_ID=       # <-- same as production
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_STORAGE_BUCKET=anjem-me.firebasestorage.app

# Mapbox — same tokens as production
MAPBOX_PUBLIC_TOKEN=      # <-- same as production
MAPBOX_SECRET_TOKEN=      # <-- same as production

# Ride Settings
DEFAULT_RIDE_TIMEOUT_MINUTES=10
MAX_DRIVER_DISTANCE_KM=5
BASE_FARE_RP=5000
FARE_PER_KM_RP=3000

# Pusher (unused — Reverb handles WebSocket)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=staging-ws.anjem.me
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=       # <-- fill from Sentry (staging project or same DSN)
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_ENVIRONMENT=staging
