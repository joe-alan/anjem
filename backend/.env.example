APP_NAME="Anjem API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anjemme
DB_USERNAME=jonathanalanohasihol
DB_PASSWORD=***REDACTED***

# Caching and Sessions
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=1440

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@anjem.me"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:3000,::1,localhost:3000

# Laravel Reverb WebSocket Configuration
REVERB_APP_ID=anjem-mvp
REVERB_APP_KEY=your-reverb-key-here
REVERB_APP_SECRET=your-reverb-secret-here
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Firebase Configuration (for push notifications)
FIREBASE_SERVER_KEY=your-firebase-server-key-here
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Maps API (for distance calculations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# WhatsApp Business API (for notifications)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Rate Limiting
OTP_RATE_LIMIT_PER_IP=5
OTP_RATE_LIMIT_WINDOW_MINUTES=30

# Ride Settings
DEFAULT_RIDE_TIMEOUT_MINUTES=10
MAX_DRIVER_DISTANCE_KM=5
BASE_FARE_RP=5000
FARE_PER_KM_RP=3000

# Pusher Configuration (fallback for WebSocket)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
