{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel-api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=0.0.0.0", "--port=8000"],
      "port": 8000
    },
    {
      "name": "laravel-reverb",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "reverb:start", "--host=0.0.0.0", "--port=8080"],
      "port": 8080
    },
    {
      "name": "docker-services",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["up", "postgres", "redis"],
      "port": 5432
    }
  ]
}
